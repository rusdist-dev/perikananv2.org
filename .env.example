# Salin ke .env.local. Semua nilai di sini opsional -- scaffold jalan tanpa satu pun.

# 'local' (default) membaca src/data/*.json lewat filesystem.
# 'api' membuat lib/content/source.ts fetch ke CONTENT_API_URL dengan next: { tags }.
CONTENT_SOURCE=local

# Wajib diisi kalau CONTENT_SOURCE=api. Tanpa itu source.ts melempar saat boot,
# bukan diam-diam jatuh balik ke JSON lokal -- kegagalan konfigurasi harus berisik.
# CONTENT_API_URL=

# Dipakai sitemap/canonical saat deploy di URL non-produksi (preview branch).
# Kalau kosong, lib/site.ts memakai https://perikanan.org.
# NEXT_PUBLIC_SITE_URL=

# Dipakai scripts/check-links.mjs dan playwright.config.ts.
# BASE_URL=http://localhost:3100
